# Template for /etc/habit_tracker/habit_tracker.env; root-owned, mode 0600.
# Generate a real random SECRET_KEY on the server. Do not use the empty value.
APP_ENV=production
SECRET_KEY=
DATABASE_PATH=/var/lib/habit_tracker/habit_tracker.sqlite3
TRUST_PROXY_HEADERS=1
TRUSTED_HOSTS=habits.gilinsky.ru
